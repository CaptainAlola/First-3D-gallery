# .env.example - Copy this file to .env and fill in your values
# This file is NOT tracked by git (see .gitignore)
# Never commit real secrets to version control!

# Django Secret Key (use a long, random string for production)
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-v0i6@k!7r(2shy1bbm^x3bfsa**wr58wtm8$6nw@i8s!dr93qe

# Debug mode
# Set to "True" only during development, always "False" in production
DEBUG=False

# Allowed hosts - comma-separated list of domains that can access this app
# In development: localhost, 127.0.0.1
# In production: your_domain.com
# Format: host1.com,host2.com,subdomain.host.com
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Optional: Database URL (if using PostgreSQL or other database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: Email configuration (for sending emails)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
